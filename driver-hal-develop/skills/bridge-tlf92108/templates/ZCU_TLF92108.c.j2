Std_ReturnType {{ PREFIX }}_EepromWrite(uint8 addr, uint8 data)
{
    Std_ReturnType ret;
    ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_EEPROM_ADDR, addr);
    if (ret != E_OK) {
