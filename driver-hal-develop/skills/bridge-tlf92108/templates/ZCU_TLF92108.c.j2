/*===========================================================================*/
/* SPI Register Access                                                       */
/*===========================================================================*/
/**
 * @brief Read a register via SPI
 */
Std_ReturnType {{ PREFIX }}_ReadReg(uint8 addr, uint8 *data)
{
    Std_ReturnType ret;

    if (!{{ PREFIX }}_State.isInitialized) {
        return E_NOT_OK;
    }

    SuspendAllInterrupts();
    ret = {{ PREFIX }}_SpiReadReg(addr, data);
    ResumeAllInterrupts();

    return ret;
}

/**
 * @brief Write a register via SPI with shadow verification
 */
Std_ReturnType {{ PREFIX }}_WriteReg(uint8 addr, uint8 data)
{
    Std_ReturnType ret;
    uint8 shadowVal;

    if (!{{ PREFIX }}_State.isInitialized) {
        return E_NOT_OK;
    }

    SuspendAllInterrupts();
    ret = {{ PREFIX }}_SpiWriteReg(addr, data);
    ResumeAllInterrupts();

    if (ret != E_OK) {
        return ret;
    }

    /* Shadow register write-after-readback verification */
    ret = {{ PREFIX }}_VerifyShadow(addr, data);
    return ret;
}

static Std_ReturnType {{ PREFIX }}_SpiReadReg(uint8 addr, uint8 *data)
{
    Std_ReturnType ret;
    ret = Spi_ReadReg(addr, data);
    return ret;
}

static Std_ReturnType {{ PREFIX }}_SpiWriteReg(uint8 addr, uint8 data)
{
    Std_ReturnType ret;
    ret = Spi_WriteReg(addr, data);
    return ret;
}

static Std_ReturnType {{ PREFIX }}_VerifyShadow(uint8 addr, uint8 expected)
{
    uint8 readback;
    Std_ReturnType ret;
    ret = {{ PREFIX }}_SpiReadReg(addr, &readback);
    if (ret != E_OK) {
        return ret;
    }
    if (readback != expected) {
        return E_NOT_OK;
    }
    return E_OK;
}

/*===========================================================================*/
/* Initialization                                                            */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_Init(const {{ PREFIX }}_ConfigType *cfgPtr)
{
    Std_ReturnType ret;

    {{ PREFIX }}_State.currentState = {{ PREFIX }}_STATE_INITIALIZATION;
    {{ PREFIX }}_State.initPhase    = {{ PREFIX }}_PHASE_INIT_SPI;

    /* Phase 1: SPI interface init */
    ret = Spi_Init(cfgPtr->spiMaxFreq, cfgPtr->spiCpol, cfgPtr->spiCpha);
    if (ret != E_OK) {
        {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_FAILED;
        return ret;
    }
    {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_UNLOCK;

    /* Phase 2: Unlock protection registers */
    ret = {{ PREFIX }}_UnlockProtRegs();
    if (ret != E_OK) {
        {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_FAILED;
        return ret;
    }
    {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_CFG;

    /* Phase 3: Configure device */
    ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_GEN, 0x00U);
    if (ret != E_OK) {
        {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_FAILED;
        return ret;
    }

    /* Phase 4: Initialize LED channels */
    {{ PREFIX }}_State.currentHighBeamMa = 0U;
    {{ PREFIX }}_State.currentLowBeamMa  = 0U;
    {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_CHANNELS;

    memcpy(&{{ PREFIX }}_ConfigStore, cfgPtr, sizeof({{ PREFIX }}_ConfigType));
    {{ PREFIX }}_State.currentState = {{ PREFIX }}_STATE_STANDBY;
    {{ PREFIX }}_State.isInitialized = TRUE;
    {{ PREFIX }}_State.opState = {{ PREFIX }}_OPSTATE_READY;
    {{ PREFIX }}_State.initPhase = {{ PREFIX }}_PHASE_INIT_DONE;

    return E_OK;
}

Std_ReturnType {{ PREFIX }}_DeInit(void)
{
    {{ PREFIX }}_State.isInitialized = FALSE;
    {{ PREFIX }}_State.currentState  = {{ PREFIX }}_STATE_SLEEP;
    {{ PREFIX }}_State.opState       = {{ PREFIX }}_OPSTATE_IDLE;
    return Spi_DeInit();
}

/*===========================================================================*/
/* Main Function (Periodic ~FAULT_POLL_MS)                                   */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_MainFunction(void)
{
    Std_ReturnType ret = E_OK;
    {{ PREFIX }}_FaultInfoType faultInfo;

    if (!{{ PREFIX }}_State.isInitialized) {
        return E_NOT_OK;
    }

    /* Fault monitoring */
    ret = {{ PREFIX }}_ReadFaults(&faultInfo);
    if (ret != E_OK || faultInfo.faultCode != 0U) {
        {{ PREFIX }}_State.faultSampleCnt++;
        if ({{ PREFIX }}_State.faultSampleCnt >= {{ FAULT_SAMPLE_MAX }}U) {
            {{ PREFIX }}_State.currentState = {{ PREFIX }}_STATE_FAULT;
            {{ PREFIX }}_State.opState      = {{ PREFIX }}_OPSTATE_FAULT;
        }
    } else {
        {{ PREFIX }}_State.faultSampleCnt = 0U;
    }

    /* Cross-check: high beam and low beam current plausibility */
    if ({{ PREFIX }}_State.currentState == {{ PREFIX }}_STATE_ACTIVE) {
        uint32 delta = (uint32){{ PREFIX }}_State.currentHighBeamMa >
                       (uint32){{ PREFIX }}_State.currentLowBeamMa ?
                       (uint32){{ PREFIX }}_State.currentHighBeamMa -
                       (uint32){{ PREFIX }}_State.currentLowBeamMa :
                       (uint32){{ PREFIX }}_State.currentLowBeamMa -
                       (uint32){{ PREFIX }}_State.currentHighBeamMa;
        if (delta > {{ PREFIX }}_CURRENT_PLAUSIBILITY_DELTA) {
            /* Log plausibility fault */
        }
    }

    /* State transition if pending */
    if ({{ PREFIX }}_State.currentState != {{ PREFIX }}_State.targetState) {
        ret = {{ PREFIX }}_TransitionState({{ PREFIX }}_State.targetState);
    }

    return ret;
}

/*===========================================================================*/
/* Protection Register Access                                                */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_UnlockProtRegs(void)
{
    return {{ PREFIX }}_WriteProtectRegs((const uint8[]){
        {{ PREFIX }}_UNLOCK_BYTE0, {{ PREFIX }}_UNLOCK_BYTE1,
        {{ PREFIX }}_UNLOCK_BYTE2, {{ PREFIX }}_UNLOCK_BYTE3
    });
}

Std_ReturnType {{ PREFIX }}_LockProtRegs(void)
{
    return {{ PREFIX }}_WriteProtectRegs((const uint8[]){
        {{ PREFIX }}_LOCK_BYTE0, {{ PREFIX }}_LOCK_BYTE1,
        {{ PREFIX }}_LOCK_BYTE2, {{ PREFIX }}_LOCK_BYTE3
    });
}

static Std_ReturnType {{ PREFIX }}_WriteProtectRegs(const uint8 *seq)
{
    uint8 i;
    Std_ReturnType ret;

    for (i = 0U; i < {{ PREFIX }}_PROT_SEQ_LEN; i++) {
        SuspendAllInterrupts();
        ret = {{ PREFIX }}_SpiWriteReg(0x00U, seq[i]);
        ResumeAllInterrupts();
        if (ret != E_OK) {
            return ret;
        }
    }
    return E_OK;
}

/*===========================================================================*/
/* Device State Management                                                   */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_SetState({{ PREFIX }}_DeviceStateType state)
{
    {{ PREFIX }}_State.targetState = state;
    return E_OK;
}

Std_ReturnType {{ PREFIX }}_GetState({{ PREFIX }}_DeviceStateType *state)
{
    if (state == NULL_PTR) {
        return E_NOT_OK;
    }
    *state = {{ PREFIX }}_State.currentState;
    return E_OK;
}

static Std_ReturnType {{ PREFIX }}_TransitionState({{ PREFIX }}_DeviceStateType target)
{
    Std_ReturnType ret = E_OK;

    switch (target) {
        case {{ PREFIX }}_STATE_STANDBY:
            ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_GEN, 0x00U);
            break;
        case {{ PREFIX }}_STATE_ACTIVE:
            ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_GEN, 0x01U);
            break;
        case {{ PREFIX }}_STATE_DIMMING:
            {{ PREFIX }}_State.dimmingActive = TRUE;
            ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_GEN, 0x02U);
            break;
        case {{ PREFIX }}_STATE_FAULT:
            ret = {{ PREFIX }}_ClearFaults();
            {{ PREFIX }}_State.currentState = {{ PREFIX }}_STATE_STANDBY;
            break;
        default:
            ret = E_NOT_OK;
            break;
    }

    if (ret == E_OK) {
        {{ PREFIX }}_State.currentState = target;
    }
    return ret;
}

/*===========================================================================*/
/* LED Current Control                                                       */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_SetCurrentHighBeam(uint16 current_ma)
{
    if (current_ma > 2000U) {
        current_ma = 2000U;
    }
    {{ PREFIX }}_State.currentHighBeamMa = current_ma;
    return {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_HIGH_BEAM, (uint8)(current_ma & 0xFFU));
}

Std_ReturnType {{ PREFIX }}_SetCurrentLowBeam(uint16 current_ma)
{
    if (current_ma > 2000U) {
        current_ma = 2000U;
    }
    {{ PREFIX }}_State.currentLowBeamMa = current_ma;
    return {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_CTRL_LOW_BEAM, (uint8)(current_ma & 0xFFU));
}

/*===========================================================================*/
/* Fault Management                                                          */
/*===========================================================================*/
Std_ReturnType {{ PREFIX }}_ReadFaults({{ PREFIX }}_FaultInfoType *info)
{
    Std_ReturnType ret;
    uint8 faultReg;

    ret = {{ PREFIX }}_ReadReg({{ PREFIX }}_REG_FAULT_STATUS, &faultReg);
    if (ret != E_OK) {
        return ret;
    }
    info->faultCode = faultReg;
    info->faultStatusReg = faultReg;
    return E_OK;
}

Std_ReturnType {{ PREFIX }}_ClearFaults(void)
{
    Std_ReturnType ret;
    uint8 verify;

    /* Write 0xFF to clear all fault bits (read-to-clear) */
    ret = {{ PREFIX }}_WriteReg({{ PREFIX }}_REG_FAULT_STATUS, 0xFFU);
    if (ret != E_OK) {
        return ret;
    }

    /* Read-after-clear verification */
    ret = {{ PREFIX }}_ReadReg({{ PREFIX }}_REG_FAULT_STATUS, &verify);
    if (ret != E_OK) {
        return ret;
    }
    if (verify != 0x00U) {
        return E_NOT_OK;
    }
    {{ PREFIX }}_State.faultSampleCnt = 0U;
    return E_OK;
}

Std_ReturnType {{ PREFIX }}_GetFaultCode(uint8 *code)
{
    if (code == NULL_PTR) {
        return E_NOT_OK;
    }
    *code = {{ PREFIX }}_State.faultInfo.faultCode;
    return E_OK;
}

